# ============================================================
# TRAVEL BUDDY - BACKEND ENVIRONMENT
#
# Copy to .env and fill in real values. NEVER commit .env.
#
# PowerShell:
#   $env:DB_PASSWORD = "..."
#   $env:JWT_SECRET  = "..."
#   .\mvnw.cmd spring-boot:run
# ============================================================

# ---------- DATABASE ----------

DB_URL=jdbc:mysql://localhost:3306/travel_buddy?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ---------- JWT ----------

# REQUIRED. Minimum 32 bytes for HS256.
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in milliseconds (15 minutes).
JWT_EXPIRATION_MS=900000

# ---------- PARTNER KYC DOCUMENTS ----------

# Where uploaded identity, licence and registration files are stored.
# Keep this OUTSIDE any folder served by a web server.
KYC_STORAGE_PATH=./uploads/kyc

# ---------- PAYMENT ----------

# Leave disabled in development to use the mock payment gateway.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=